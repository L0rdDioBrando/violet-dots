{
  "height": 30,
  "spacing": 5,
  "margin-top": 3,
  "margin-left": 4,
  "margin-right": 4,
  "modules-left": [
    "niri/workspaces",
    "cava"
  ],
  "modules-center": [
    "custom/music"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "temperature",
    "clock",
    "pulseaudio",
    "battery",
    "niri/language",
    "custom/notification"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "cava": {
    "framerate": 180,
    "bars": 18,
    "autosens": 1,
    "sensitivity": 2,
    "format-icons": [
      " ",
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "method": "pipewire",
    "bar_width": 0,
    "bar_delimiter": 0,
    "source": "auto",
    "noise_reduction": 0.77,
    "input_delay": 2
  },
  "custom/music": {
    "format": "  {}",
    "escape": true,
    "exec": "playerctl -F -p strawberry,mpv,firefox,%any metadata --format '{{artist}} ~ {{title}}'",
    "max-length": 50,
    "on-click": "~/.config/waybar/active-player.sh",
    "tooltip": false
  },
  "cpu": {
    "interval": 1,
    "format": "{usage}% ",
    "tooltip-format": "{usage_percore}"
  },
  "memory": {
    "interval": 1,
    "format": "{used:0.1f}/{total:0.1f}G "
  },
  "temperature": {
    "interval": 1,
    "thermal-zone": 2,
    "critical-threshold": 80,
    "format": "{temperatureC}°C "
  },
  "clock": {
    "format": "{:%H:%M} ",
    "format-alt": "{:%Y-%m-%d} ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#b7bdf8'><b>{}</b></span>",
        "days": "<span color='#cad3f5'>{}</span>",
        "weeks": "<span color='#8bd5ca'>W{}</span>",
        "weekdays": "<span color='#eed49f'><b>{}</b></span>",
        "today": "<span color='#b7bdf8'><b><u>{}</u></b></span>"
      }
    }
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "niri/language": {
    "format": "{short} 󰗊",
    "format-alt": "{long} 󰗊"
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#f5a97f'><sup></sup></span>",
      "none": "",
      "inhibited-notification": "<span foreground='#ed8796'><sup></sup></span>",
      "inhibited-none": "<span foreground='#ed8796'><sup></sup></span>",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  }
}
