{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json", // Optional: Provides IDE intelligence
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "color": {             // Override logo colors
            "1": "#b7bdf8"
        }
    },
    "display": { 
        "separator": ": ",
        "key": {
            "width": 12,       // Aligns keys to this width
            "type": "both"   // string, icon, both, or none
        },
    },
    "modules": [
        {
            "type": "os",
            "key": "os",
            "keyColor": "blue",
            "format": "{name} {version}"
        },
        {
            "type": "kernel",
            "key":  "kernel",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key":  "shell",
            "keyColor": "blue"
        },
        {
            "type": "display",
            "key": "display",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": "cpu",
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "keyColor": "cyan"
        },
        {
            "type": "disk",
            "key": "disk",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "cyan"
        },
        {
            "type": "de",
            "key": "de",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "wm",
            "key": "wm",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "theme",
            "key": "theme",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "cursor",
            "key": "cursor",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "icons",
            "key": "icons",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "font",
            "key": "font",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "terminal",
            "key": "terminal",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "media",
            "key": "music",
            "keyColor": "#b7bdf8"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "block": { "width": 1 }
        }
    ]
}