{
  "height": 30,
  "spacing": 5,
  "margin-top": 3,
  "margin-left": 4,
  "margin-right": 4,
  "modules-left": [
    "niri/workspaces",
    "cava"
  ],
  "modules-center": [
    "group/group-music"
  ],
  "modules-right": [
    "group/group-hard",
    "group/group-status",
    "group/group-other"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "cava": {
    "framerate": 180,
    "bars": 18,
    "autosens": 1,
    "sensitivity": 2,
    "format-icons": [
      " ",
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
    "method": "pipewire",
    "bar_width": 0,
    "bar_delimiter": 0,
    "source": "auto",
    "noise_reduction": 0.77,
    "input_delay": 2
  },
  "custom/music": {
    "format": "  {}",
    "escape": false,
    "return-type": "json",
    "exec": "~/music-info.sh",
    "max-length": 50,
    "on-click": "~/.config/waybar/active-player.sh"
  },
  "custom/prev": {
    "format": "󰙣 ",
    "return-type": "json",
    "exec": "playerctl -p spotify,strawberry,firefox,mpv,%any metadata --format '{\"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F 2>/dev/null",
    "tooltip": true,
    "on-click": "playerctl -p spotify,strawberry,firefox,mpv,%any previous"
  },
  "custom/playpause": {
    "format": "{icon}",
    "return-type": "json",
    "exec": "playerctl -p spotify,strawberry,firefox,mpv,%any metadata --format '{\"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
    "tooltip": false,
    "format-icons": {
      "Playing": "",
      "Paused": ""
    },
    "on-click": "playerctl -p spotify,strawberry,firefox,mpv,%any play-pause"
  },
  "custom/next": {
    "format": " 󰙡 ",
    "return-type": "json",
    "exec": "playerctl -p spotify,strawberry,firefox,mpv,%any metadata --format '{\"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F 2>/dev/null",
    "tooltip": false,
    "on-click": "playerctl -p spotify,strawberry,firefox,mpv,%any next"
  },
  "group/group-music": {
    "max-length": 50,
    "orientation": "horizontal",
    "modules": [
      "custom/music",
      "custom/prev",
      "custom/playpause",
      "custom/next"
    ]
  },
  "cpu": {
    "interval": 1,
    "format": " {usage}%  ",
    "tooltip-format": "{usage_percore}"
  },
  "memory": {
    "interval": 1,
    "format": " {used:0.1f}/{total:0.1f}G  "
  },
  "temperature": {
    "interval": 1,
    "thermal-zone": 2,
    "critical-threshold": 80,
    "format-critical": " {temperatureC}°C  ",
    "format": " {temperatureC}°C  "
  },
  "group/group-hard": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "temperature"
    ]
  },
  "clock": {
    "format": " {:%H:%M}  ",
    "format-alt": " {:%Y-%m-%d}  ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#b7bdf8'><b>{}</b></span>",
        "days": "<span color='#cad3f5'>{}</span>",
        "weeks": "<span color='#8bd5ca'>W{}</span>",
        "weekdays": "<span color='#eed49f'><b>{}</b></span>",
        "today": "<span color='#b7bdf8'><b><u>{}</u></b></span>"
      }
    }
  },
  "wireplumber": {
    "format": " {volume}% {icon} ",
    "max-volume": 100,
    "format-muted": "󰝟 ",
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " ",
      " ",
      " ",
      " ",
      " ",
      " "
    ],
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "battery": {
    "interval": 1,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": " {capacity}% {icon} ",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "max-length": 25
  },
  "group/group-status": {
    "orientation": "horizontal",
    "modules": [
      "clock",
      "wireplumber",
      "battery"
    ]
  },
  "niri/language": {
    "format": " {short} 󰗊 ",
    "format-alt": " {long} 󰗊 "
  },
  "custom/notification": {
    "tooltip": false,
    "format": " {icon} ",
    "format-icons": {
      "notification": "<span foreground='#f5a97f'><sup></sup></span>",
      "none": "<span foreground='#b7bdf8'><sup></sup></span>",
      "inhibited-notification": "<span foreground='#ed8796'><sup></sup></span>",
      "inhibited-none": "<span foreground='#ed8796'><sup></sup></span>",
      "dnd-notification": "󰂛<span foreground='#8aadf4'><sup></sup></span>",
      "dnd-none": "󰂛<span foreground='#8aadf4'><sup></sup></span>",
      "dnd-inhibited-notification": "󰂛<span foreground='#8aadf4'><sup></sup></span>",
      "dnd-inhibited-none": "󰂛<span foreground='#8aadf4'><sup></sup></span>"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "escape": true
  },
  "group/group-other": {
    "orientation": "horizontal",
    "modules": [
      "niri/language",
      "custom/notification"
    ]
  }
}
